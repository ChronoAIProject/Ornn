# Dependency inputs come from the committed lockfile, including every workspace
# and override. App source/package version/scripts do not invalidate installation.
FROM oven/bun:1.3.14@sha256:50317d83cd5a5ae1d8b35b3379c69f57ce1a0dbf4def91f0965653d767851834 AS install
WORKDIR /app
COPY bun.lock ./
COPY scripts/ci/staging-api-dependencies.mjs /tmp/dependencies.mjs
RUN bun /tmp/dependencies.mjs bun.lock . \
 && bun install --frozen-lockfile --production --filter ornn-api \
 && find /app/node_modules/.bun -type d \( -name test -o -name tests \
      -o -name __tests__ -o -name __fixtures__ -o -name examples -o -name docs \) \
      -prune -exec rm -rf '{}' + \
 && find /app/node_modules/.bun -type f \( -name '*.map' -o -iname 'readme*' \
      -o -name '.coveralls.yml' \) -delete \
 && find /app -exec touch -h -d '@0' '{}' +

# Runtime stage
FROM oven/bun:1.3.14@sha256:50317d83cd5a5ae1d8b35b3379c69f57ce1a0dbf4def91f0965653d767851834 AS runtime

WORKDIR /app

# AgentSeal trust scanner (#253) — installed via pip into an isolated
# venv at /opt/agentseal so we don't fight Debian 12's PEP-668 ban on
# global pip installs. Pin the version explicitly so trust scores are
# reproducible across a known rule set; bumping it is intentional and
# shows up in CHANGELOG.
#
# We don't use the agentseal CLI directly — its `guard` subcommand is
# designed to scan installed agent configs on a developer's machine,
# not arbitrary skill packages. Instead `scan_skill.py` (copied below)
# imports `agentseal.skill_scanner.SkillScanner` and runs it per file
# in an extracted skill ZIP. Ornn-api spawns this script as a subprocess.
ARG AGENTSEAL_VERSION=0.9.6
ENV AGENTSEAL_VERSION=${AGENTSEAL_VERSION}
ENV AGENTSEAL_VENV=/opt/agentseal
# Remove unused manuals in the install layer: OpenSSL documentation includes
# example session keys that should not ship in a public application image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && python3 -m venv "$AGENTSEAL_VENV" \
 && "$AGENTSEAL_VENV/bin/pip" install --no-cache-dir "agentseal==${AGENTSEAL_VERSION}" \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /usr/share/man /usr/share/info /usr/share/python-wheels \
      "$AGENTSEAL_VENV/lib/python3.13/site-packages/pip" \
      "$AGENTSEAL_VENV/lib/python3.13/site-packages/pip-"*.dist-info \
 && find /usr/share/doc -type f ! -name copyright ! -name copyright.gz -delete \
 && find /usr/lib/python3.13 "$AGENTSEAL_VENV/lib/python3.13" -type d \
      \( -name __pycache__ -o -name tests -o -name test \) -prune -exec rm -rf '{}' +

# Runtime-generated installer logs and inode caches are not runtime inputs.
RUN rm -rf /var/log/apt/* /var/log/dpkg.log /var/log/alternatives.log \
      /var/cache/ldconfig/aux-cache

# Normalize the sanitized snapshot before any dependency or application input.
# Do not expose inherited manuals by publishing the intermediate runtime layers.
FROM oven/bun:1.3.14@sha256:50317d83cd5a5ae1d8b35b3379c69f57ce1a0dbf4def91f0965653d767851834 AS base-export
COPY --from=runtime / /rootfs/
RUN mkdir -p /rootfs/app/ornn-api /rootfs/app/data \
 && chown 1000:1000 /rootfs/app/data \
 && find /rootfs -exec touch -h -d '@0' '{}' +

# Package all application-owned files in one final layer. This stage also checks
# that the real manifests still match the lockfile's dependency declarations.
FROM oven/bun:1.3.14@sha256:50317d83cd5a5ae1d8b35b3379c69f57ce1a0dbf4def91f0965653d767851834 AS application
WORKDIR /inputs
COPY bun.lock package.json ./
COPY ornn-api/package.json ornn-api/
COPY ornn-web/package.json ornn-web/
COPY sdk/typescript/package.json sdk/typescript/
COPY scripts/ci/staging-api-dependencies.mjs /tmp/dependencies.mjs
RUN bun /tmp/dependencies.mjs --check bun.lock .
COPY ornn-api/package.json /payload/app/ornn-api/package.json
COPY ornn-api/scripts/scan_skill.py /payload/opt/agentseal/scan_skill.py
COPY ornn-api/src/ /payload/app/ornn-api/src/
RUN find /payload -exec touch -h -d '@0' '{}' +

FROM scratch
COPY --from=base-export /rootfs/ /
ARG AGENTSEAL_VERSION=0.9.6
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/bun-node-fallback-bin \
    BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 \
    BUN_INSTALL_BIN=/usr/local/bin \
    AGENTSEAL_VERSION=${AGENTSEAL_VERSION} \
    AGENTSEAL_VENV=/opt/agentseal \
    AGENTSEAL_PYTHON=/opt/agentseal/bin/python \
    AGENTSEAL_SCRIPT=/opt/agentseal/scan_skill.py
WORKDIR /app/ornn-api
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
LABEL org.opencontainers.image.source="https://github.com/ChronoAIProject/Ornn"
USER 1000:1000
EXPOSE 3802
CMD ["bun", "run", "src/index.ts"]
# Last two layers depend only on dependencies, then application inputs. No squash.
COPY --from=install /app/node_modules/ /app/node_modules/
COPY --from=application /payload/ /
