# Derive NYXID_API_HOST from NYXID_API_BASE_URL so the standard
# nginx 20-envsubst-on-templates.sh can substitute it into nginx.conf.template.
# Sourced (note the .envsh extension) so the export propagates to sibling
# entrypoint scripts. Without this the operator would have to maintain
# the host as a separate var that mirrors the base URL.
#
# Strips scheme + path, leaving "host[:port]". Empty/unset NYXID_API_BASE_URL
# leaves NYXID_API_HOST empty too — nginx will then fall back to whatever
# host the proxy_pass URL resolves to, which is the right thing for
# in-cluster plain-HTTP upstreams.

if [ -n "${NYXID_API_BASE_URL:-}" ]; then
    # shellcheck disable=SC3043
    _stripped="${NYXID_API_BASE_URL#*://}"
    NYXID_API_HOST="${_stripped%%/*}"
    export NYXID_API_HOST
    unset _stripped
fi
